{
  "name": "its-good-to-be-king",
  "version": "1.0.0",
  "type": "module",
  "description": "A personal dashboard application.",
  "main": "src/index.tsx",
  "scripts": {
    "start": "serve .",
    "build": "vite build",
    "dev": "vite",
    "compile": "tsc src/index.tsx --outDir dist --target es2020 --module es2020 --moduleResolution node",
    "test": "vitest run",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"*.{js,ts}\" --max-warnings=0",
    "format": "prettier --write \"src/app/**/*.ts\" \"src/domains/**/*.ts\" \"src/infra/**/*.ts\" \"src/components/modals/**/*.ts\" \"src/core/__tests__/**/*.ts\" \"src/utils/__tests__/**/*.ts\" \"src/index.tsx\" \"docs/**/*.md\" \"AGENTS.md\" \"README.md\" \"QUICK_START.md\" \"SUPABASE_SETUP.md\" \"package.json\" \"tsconfig.json\" \"vitest.config.ts\" \".eslintrc.json\" \".github/workflows/ci.yml\"",
    "format:check": "prettier --check \"src/app/**/*.ts\" \"src/domains/**/*.ts\" \"src/infra/**/*.ts\" \"src/components/modals/**/*.ts\" \"src/core/__tests__/**/*.ts\" \"src/utils/__tests__/**/*.ts\" \"src/index.tsx\" \"docs/**/*.md\" \"AGENTS.md\" \"README.md\" \"QUICK_START.md\" \"SUPABASE_SETUP.md\" \"package.json\" \"tsconfig.json\" \"vitest.config.ts\" \".eslintrc.json\" \".github/workflows/ci.yml\"",
    "type-check": "tsc --noEmit",
    "check:architecture": "node ./scripts/check-architecture.mjs",
    "test:changed": "node ./scripts/run-changed-tests.mjs",
    "agent:prepr": "npm run verify && npm run check:architecture && npm run test:changed",
    "verify": "npm run type-check && npm run lint && npm run test && npm run check:architecture && npm run build",
    "preview": "vite preview",
    "supabase:setup": "./setup-supabase.sh",
    "supabase:push": "bash -c 'set -a && . ./.env.local && set +a && supabase db push --linked'",
    "supabase:push:local": "supabase db push --local",
    "supabase:migrations": "bash -c 'set -a && . ./.env.local && set +a && supabase migration list --linked'",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:types": "bash -c 'set -a && . ./.env.local && set +a && supabase gen types typescript --linked > src/lib/supabase.types.ts'",
    "supabase:types:local": "supabase gen types typescript --local > src/lib/supabase.types.ts",
    "vercel:deploy": "vercel --prod",
    "vercel:preview": "vercel",
    "vercel:env:pull": "vercel env pull .env.local",
    "vercel:env:ls": "vercel env ls",
    "vercel:projects": "vercel projects list"
  },
  "keywords": [
    "dashboard",
    "perplexity",
    "personal"
  ],
  "author": "Akki Boy",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^24.2.0",
    "@types/react": "^18.3.25",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "@vitejs/plugin-react": "^5.1.2",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.57.0",
    "postcss": "^8.4.32",
    "prettier": "^3.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "serve": "^14.2.1",
    "tailwindcss": "^3.3.6",
    "typescript": "^5.9.2",
    "vercel": "^48.12.0",
    "vite": "^5.0.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.0.18",
    "workbox-window": "^7.4.1"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.39.0",
    "lucide-react": "^0.294.0"
  }
}
