{
  "name": "its-good-to-be-king",
  "version": "1.0.0",
  "type": "module",
  "description": "A personal dashboard application.",
  "main": "src/home/entry.ts",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "serve .",
    "build": "vite build",
    "dev": "vite",
    "test": "vitest run",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"*.{js,ts}\" --max-warnings=0",
    "format": "prettier --write \"src/home/**/*.ts\" \"src/platform/**/*.ts\" \"src/sdk/**/*.ts\" \"src/utils/**/*.ts\" \"convex/**/*.ts\" \"docs/**/*.md\" \"AGENTS.md\" \"README.md\" \"QUICK_START.md\" \"package.json\" \"tsconfig.json\" \"vitest.config.ts\" \".eslintrc.json\" \".github/workflows/ci.yml\"",
    "format:check": "prettier --check \"src/home/**/*.ts\" \"src/platform/**/*.ts\" \"src/sdk/**/*.ts\" \"src/utils/**/*.ts\" \"convex/**/*.ts\" \"docs/**/*.md\" \"AGENTS.md\" \"README.md\" \"QUICK_START.md\" \"package.json\" \"tsconfig.json\" \"vitest.config.ts\" \".eslintrc.json\" \".github/workflows/ci.yml\"",
    "type-check": "tsc --noEmit",
    "check:architecture": "node ./scripts/check-architecture.mjs",
    "test:changed": "node ./scripts/run-changed-tests.mjs",
    "agent:prepr": "npm run verify && npm run check:architecture && npm run test:changed",
    "verify": "npm run type-check && npm run lint && npm run test && npm run check:architecture && npm run build",
    "preview": "vite preview",
    "convex:dev": "convex dev",
    "convex:deploy": "convex deploy",
    "convex:codegen": "convex codegen",
    "vercel:deploy": "vercel --prod",
    "vercel:preview": "vercel",
    "vercel:env:pull": "vercel env pull .env.local",
    "vercel:env:ls": "vercel env ls",
    "vercel:projects": "vercel projects list",
    "jarvis:pair-headless": "node ./scripts/pair-jarvis-headless.mjs",
    "new:module": "node ./scripts/new-module.mjs"
  },
  "keywords": [
    "personal",
    "pwa",
    "orbit"
  ],
  "author": "Akki Boy",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^24.2.0",
    "@types/web-push": "^3.6.4",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.57.0",
    "postcss": "^8.4.32",
    "prettier": "^3.8.1",
    "serve": "^14.2.1",
    "tailwindcss": "^3.3.6",
    "typescript": "^5.9.2",
    "vercel": "^48.12.0",
    "vite": "^5.0.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.0.18",
    "workbox-window": "^7.4.1"
  },
  "dependencies": {
    "@convex-dev/auth": "^0.0.94",
    "convex": "^1.42.0",
    "web-push": "^3.6.7"
  }
}
