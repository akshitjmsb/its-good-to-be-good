# It's Good To Be King - environment variables
# Copy this file to .env.local and fill in the values.

# Cloud Supabase — public (frontend)
# Dashboard -> Project Settings -> API Keys
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon public key>

# Cloud Supabase — secrets (server/CLI only; never expose to frontend)
SUPABASE_DB_PASSWORD=<postgres password>
SUPABASE_ACCESS_TOKEN=<PAT from dashboard -> Account -> Access Tokens>
SUPABASE_SERVICE_ROLE_KEY=<service role JWT>

# Optional: local Supabase fallback for offline dev
# VITE_SUPABASE_URL=http://127.0.0.1:54321
# VITE_SUPABASE_ANON_KEY=<local publishable key from `supabase status`>

# Optional: Perplexity API key for AI features.
# If omitted, the app uses built-in fallback content.
VITE_PERPLEXITY_API_KEY=<optional key>

# Security: .env.local is gitignored. Never commit real keys/tokens.
