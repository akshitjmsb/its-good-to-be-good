# It's Good To Be King - environment variables
# Copy this file to .env.local and fill in the values.

# Convex (frontend). Provisioned automatically by `npx convex dev`, which
# writes CONVEX_DEPLOYMENT and VITE_CONVEX_URL into .env.local for you.
VITE_CONVEX_URL=https://<your-deployment>.convex.cloud
# CONVEX_DEPLOYMENT=<set automatically by `npx convex dev`>

# Convex Auth signing keys live on the Convex deployment (not here). Generate
# them with `npx @convex-dev/auth` (sets JWT_PRIVATE_KEY / JWKS on the deployment).
#
# Magic-link sign-in and password reset additionally require an email provider:
#   npx convex env set AUTH_RESEND_KEY <resend-api-key>
# Until that is configured, email + password sign-in works on its own.

# Optional: Perplexity API key for AI features.
# If omitted, the app uses built-in fallback content.
VITE_PERPLEXITY_API_KEY=<optional key>

# Optional: Anthropic (Claude) API key. Selected via the home dropdown.
# Direct browser calls require anthropic-dangerous-direct-browser-access; do
# not use this in a deployed multi-user app — the key would leak to clients.
VITE_ANTHROPIC_API_KEY=<optional key>

# Optional: local Ollama endpoint for the "Local Qwen" provider.
# Start Ollama with `OLLAMA_ORIGINS='*' ollama serve` so the browser is
# allowed to hit it. Override the model if you've pulled a different one.
VITE_OLLAMA_URL=http://localhost:11434
VITE_OLLAMA_MODEL=qwen2.5

# Security: .env.local is gitignored. Never commit real keys/tokens.
