# It's Good To Be King - local development environment
# Copy this file to .env.local and fill in the values as needed.

# Local Supabase (default local CLI port)
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=<local publishable key from supabase status>

# Optional: Perplexity API key for AI features.
# If omitted, the app uses built-in fallback content.
VITE_PERPLEXITY_API_KEY=<optional local key>

# Security: never commit .env.local or real keys/tokens.
